<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.netbeans.org/ns/project/1">
    <type>org.netbeans.modules.web.project</type>
    <configuration>
        <data xmlns="http://www.netbeans.org/ns/web-project/3">
            <name>mx.edu.itoaxaca.sividocets-war</name>
            <minimum-ant-version>1.6.5</minimum-ant-version>
            <web-module-libraries>
                <library dirs="100">
                    <file>${reference.mx_edu_itoaxaca_sividocets-ejb.dist}</file>
                </library>
                <library dirs="200">
                    <file>${file.reference.primefaces-16.0.1.jar}</file>
                    <path-in-war>WEB-INF/lib</path-in-war>
                </library>
                <library dirs="200">
                    <file>${file.reference.jakarta.ejb-api.jar}</file>
                </library>
                <library dirs="200">
                    <file>${file.reference.jakarta.enterprise.cdi-api.jar}</file>
                </library>
                <library dirs="200">
                    <file>${file.reference.jakarta.inject-api.jar}</file>
                </library>
                <library dirs="200">
                    <file>${file.reference.jakarta.faces.jar}</file>
                </library>
                <library dirs="200">
                    <file>${file.reference.jakarta.persistence-api.jar}</file>
                </library>
            </web-module-libraries>
            <web-module-additional-libraries/>
            <source-roots>
                <root id="src.dir"/>
            </source-roots>
            <test-roots>
                <root id="test.src.dir"/>
            </test-roots>
        </data>
        <references xmlns="http://www.netbeans.org/ns/ant-project-references/1">
            <reference>
                <foreign-project>mx_edu_itoaxaca_sividocets-ejb</foreign-project>
                <artifact-type>jar</artifact-type>
                <script>build.xml</script>
                <target>dist</target>
                <clean-target>clean</clean-target>
